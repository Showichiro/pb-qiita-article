{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && node node_modules/cf/bin/cf deploy --prebuilt --mode production",
    "schema:gen": "drizzle-kit generate --dialect sqlite --out migrations --schema src/db/schema.ts",
    "format": "biome format src/ --write",
    "lint": "biome lint src/ --write",
    "schema:apply": "node node_modules/cf/bin/cf d1 migrations apply 06e39e3a-7b73-4aaf-a334-ab3f95804ba5 --local --persist-to .cloudflare/state",
    "test": "vitest",
    "test:ci": "vitest --bail 1 --silent --run",
    "typecheck": "tsc --noEmit",
    "deploy:check": "bun run build && node node_modules/cf/bin/cf deploy --prebuilt --mode production --dry-run",
    "data:apply": "node scripts/applyData.mjs",
    "schema:apply:remote": "node node_modules/cf/bin/cf d1 migrations apply 06e39e3a-7b73-4aaf-a334-ab3f95804ba5",
    "data:apply:remote": "node scripts/applyData.mjs --remote"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tailwindcss/postcss": "^4.3.3",
    "bun-types": "^1.4.2",
    "cf": "1.0.0-beta.10",
    "daisyui": "^5.7.47",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20260730.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "bun": ">=1.4.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "sharp": "0.35.4",
    "undici": "7.29.1"
  }
}
